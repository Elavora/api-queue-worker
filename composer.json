{
    "name": "elavora/api-queue-worker",
    "description": "Worker opcional para consumir filas do framework Elavora",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "elavora/api-framework": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Elavora\\Api\\Extension\\QueueWorker\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "test": "@php vendor/bin/phpunit -c phpunit.xml",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
